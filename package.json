{
  "name": "osat",
  "version": "0.1.0",
  "private": true,
  "description": "OSAT — a calm, private layer over your Mac",
  "author": "Nate McCreery",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start:mac": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui/smoke.mjs",
    "install:mac": "npm run dist:mac && node scripts/install-mac.mjs",
    "test:e2e": "node tests/e2e/electron.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "ai.mccreery.osat",
    "productName": "OSAT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "desktop/**/*",
      "shared/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "OSAT-${version}-${arch}-mac.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "OSAT shows what is playing in Spotify and lets you play, pause and skip."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "masDev": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist"
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "shared/**"
    ],
    "dmg": {
      "title": "OSAT ${version}",
      "artifactName": "OSAT-${version}-${arch}.${ext}"
    }
  }
}
